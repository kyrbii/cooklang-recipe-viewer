# Folder with the .cook files
RECIPE_DIR=./data/recipes
# SQLite file for users and tokens
DB_PATH=./data/api.db
# How long a login token stays valid
TOKEN_TTL_DAYS=30
# Comma-separated origins allowed to call the API from a browser (the app's URL)
ALLOWED_ORIGINS=http://localhost:5173
# Largest accepted recipe body in bytes
MAX_RECIPE_BYTES=1000000
# AI import (POST /import): Gemini key and model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
