# Copy to .env next to docker-compose.yml and fill in.

# Public URLs as set up in Nginx Proxy Manager (https, no trailing slash)
PUBLIC_APP_URL=https://rezepte.example.com
PUBLIC_API_URL=https://rezepte-api.example.com

# Host ports the containers are published on (point the proxy hosts at these)
APP_PORT=8080
API_PORT=8000

# Where recipes, photos and api.db live on the host (owner uid 1000)
DATA_DIR=./api/data
# Where scripts/backup.py writes its archives (owner uid 1000). Copy them off the server too.
BACKUP_DIR=./backups

# AI import (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Proxies whose X-Forwarded-For is trusted for the login throttle.
# "*" is fine as long as API_PORT is only reachable by the proxy (firewall it from the LAN/internet).
FORWARDED_ALLOW_IPS=*
