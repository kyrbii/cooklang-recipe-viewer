# Copy to .env next to docker-compose.yml and fill in.

# Public URLs as set up in Nginx Proxy Manager (https, no trailing slash)
PUBLIC_APP_URL=https://stir.example.com
PUBLIC_API_URL=https://stir-api.example.com

# Image version: latest (main branch), a release like 1.0.0, or a branch name like feat-clean-room-api
STIR_VERSION=latest

# Host ports the containers are published on (point the proxy hosts at these)
APP_PORT=8080
API_PORT=8000

# Where recipes, photos and api.db live on the host (owner uid 1000)
DATA_DIR=./data
# Where scripts/backup.py writes its archives (owner uid 1000). Copy them off the server too.
BACKUP_DIR=./backups

# AI import (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Daily recipes from KptnCook (optional, unofficial API: may stop working any time).
# Today's picks are fetched once a day and kept for 3 days in DATA_DIR/../daily.
KPTNCOOK_API_KEY=

# Proxies whose X-Forwarded-For is trusted for the login throttle.
# "*" is fine as long as API_PORT is only reachable by the proxy (firewall it from the LAN/internet).
FORWARDED_ALLOW_IPS=*
